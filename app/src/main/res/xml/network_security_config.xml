<?xml version="1.0" encoding="utf-8"?>
<!--
  Permite tráfico HTTP (cleartext) a las IPs/dominios del backend NutriGuide.

  Necesario porque el backend corre sin TLS en desarrollo y K8s interno.
  En producción con dominio + cert TLS, podés eliminar este archivo.

  IPs habilitadas:
    - 10.0.2.2       → emulador Android Studio (mapea al host de tu PC)
    - 127.0.0.1      → loopback (dispositivo físico vía adb reverse)
    - 192.168.0.0/16 → red local (probar en celular conectado al WiFi de casa)
    - 10.201.1.25    → instancia UM Cloud (acceso vía red UM o ZeroTier)
    - 10.0.0.0/8     → cobertura amplia de redes privadas (incluye ZeroTier)
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.201.1.25</domain>
        <!-- Si UM Cloud expone otra IP (NodePort en distinto nodo), agregarla acá -->
    </domain-config>
    <!-- Permite cleartext también a la base-config por si la URL apunta a una
         IP no listada arriba. Solo durante desarrollo / cluster interno. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
</network-security-config>
